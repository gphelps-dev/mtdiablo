# Uncomment this line to define a global platform for your project
platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      
      # Enable modules and allow non-modular includes
      config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
      config.build_settings['DEFINES_MODULE'] = 'YES'
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      
      # Disable module verification to prevent build failures
      config.build_settings['CLANG_ENABLE_MODULE_DEBUGGING'] = 'NO'
      config.build_settings['CLANG_MODULE_VERIFICATION'] = 'NO'
      config.build_settings['CLANG_MODULE_BUILD'] = 'YES'
      config.build_settings['SKIP_MODULE_VERIFICATION'] = 'YES'
      config.build_settings['ENABLE_MODULE_VERIFICATION'] = 'NO'
      config.build_settings['SWIFT_SUPPRESS_MODULE_VERIFICATION'] = 'YES'
      config.build_settings['SWIFT_DISABLE_MODULE_VERIFICATION'] = 'YES'
      config.build_settings['CLANG_DISABLE_MODULE_VERIFICATION'] = 'YES'
      
      # Ensure framework search paths include Pods
      config.build_settings['FRAMEWORK_SEARCH_PATHS'] ||= ['$(inherited)']
      config.build_settings['FRAMEWORK_SEARCH_PATHS'] << '$(PODS_ROOT)' unless config.build_settings['FRAMEWORK_SEARCH_PATHS'].include?('$(PODS_ROOT)')
      
      # Ensure header search paths include Pods
      config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
      config.build_settings['HEADER_SEARCH_PATHS'] << '$(PODS_ROOT)/Headers/Public' unless config.build_settings['HEADER_SEARCH_PATHS'].include?('$(PODS_ROOT)/Headers/Public')
      config.build_settings['HEADER_SEARCH_PATHS'] << '$(PODS_ROOT)/Headers/Private' unless config.build_settings['HEADER_SEARCH_PATHS'].include?('$(PODS_ROOT)/Headers/Private')
    end
  end
  
  # Also fix the project-level settings
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
    config.build_settings['CLANG_MODULE_VERIFICATION'] = 'NO'
    config.build_settings['CLANG_ENABLE_MODULE_DEBUGGING'] = 'NO'
    config.build_settings['SKIP_MODULE_VERIFICATION'] = 'YES'
    config.build_settings['ENABLE_MODULE_VERIFICATION'] = 'NO'
    config.build_settings['SWIFT_SUPPRESS_MODULE_VERIFICATION'] = 'YES'
    config.build_settings['SWIFT_DISABLE_MODULE_VERIFICATION'] = 'YES'
    config.build_settings['CLANG_DISABLE_MODULE_VERIFICATION'] = 'YES'
  end
end
